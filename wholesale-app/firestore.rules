rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
   /** Public storefront catalog — anyone can read; only admins manage. */
   match /catalogProducts/{productId} {
     allow read: if true;
     allow create, update, delete: if false;
   }
   /** Public shop name/details for the storefront catalog header. */
   match /settings/shopProfile {
     allow read: if true;
   }
   match /settings/catalogFilters {
     allow read: if true;
   }
   match /{document=**} {
     allow read, write: if request.auth != null;
   }
 }
}
